<div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
'use strict';

const WORKER_URL = 'https://bloglovers-api.uzairhameed01.workers.dev';

const POST_DATA = {
    title: "ڈیجیٹل گمراہی اور اقبال کی رہنمائی",
    slug: "dyjytl-gmrahi-aur-aqbal-ki-rhnmai-aaj-ke-nojoan-ke-lye-10-bhtryn-hkmt-amlyan",
    category: "mazameen",
    categoryTitle: "مضامین",
    categoryUrl: "https://bloglovers.pk/category-pages/mazameen.html",
    tags: ['اقبال','ڈیجیٹل گمراہی','نوجوان','خودی','عمل','علم','حکمت عملی','موٹیویشن'],
    relatedPosts: [
        { title: "مسلمانوں نے اپنا وقار کیسے کھویا؟", slug: "musalmanon-ne-apna-waqar-kaise-khoya", image: "https://bloglovers.pk/images/mazameen/musalmanon-ne-apna-waqar-kaise-khoya.webp" },
        { title: "ایک جھلک افلاطون اور ارسطو کے فلسفہ پر", slug: "ek-jhalak-aflatoon-aur-arastoo-ke-falsafa-par", image: "https://bloglovers.pk/images/mazameen/ek-jhalak-aflatoon-aur-arastoo-ke-falsafa-par.webp" },
        { title: "بچوں کے لئے اسکرین کا وقت کیوں کنٹرول کرنے کی ضرورت ہے؟", slug: "bachchon-ke-liye-screen-ka-waqt-kyun-control-karne-ki-zaroorat-hai", image: "https://bloglovers.pk/images/mazameen/bachchon-ke-liye-screen-ka-waqt-kyun-control-karne-ki-zaroorat-hai.webp" },
        { title: "ٹاپ 10 ریڈنگ ٹپس", slug: "tap-10-rydng-tps", image: "https://bloglovers.pk/images/mazameen/tap-10-rydng-tps.webp" },
        { title: "ٹاپ 10 لائف اسکلز", slug: "tap-10-laf-asklz", image: "https://bloglovers.pk/images/mazameen/tap-10-laf-asklz.webp" },
        { title: "ٹاپ 10 لسنگ ٹپس", slug: "tap-10-lsnng-tps", image: "https://bloglovers.pk/images/mazameen/tap-10-lsnng-tps.webp" }
    ]
};

function calculateReadingTime() {
    const content = document.querySelector('.post-content');
    if (!content) return;
    const words = content.textContent.trim().split(/\s+/).length;
    const readingTime = Math.max(1, Math.ceil(words / 200));
    const el = document.getElementById('readingTime');
    if (el) el.textContent = readingTime;
}

async function loadPostViews() {
    try {
        const res = await fetch(`${WORKER_URL}/api/post-views/${POST_DATA.slug}`);
        const result = await res.json();
        if (result.success && result.data) {
            document.getElementById('postViews').innerText = result.data.views || 0;
        }
    } catch (e) {}
}

async function addPostView() {
    try {
        const today = new Date().toDateString();
        const key = `viewed_post_${POST_DATA.slug}_${today}`;
        if (localStorage.getItem(key) !== today) {
            await fetch(`${WORKER_URL}/api/add-post-view`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ slug: POST_DATA.slug })
            });
            localStorage.setItem(key, today);
            setTimeout(loadPostViews, 500);
        }
    } catch (e) {}
}

async function loadPostReactions() {
    try {
        const res = await fetch(`${WORKER_URL}/api/post-reactions/${POST_DATA.slug}`);
        const result = await res.json();
        if (result.success && result.data) {
            const r = result.data;
            ['excellent','interesting','useful','thoughtful','contemplative','wonderful','awesome'].forEach(k => {
                const el = document.getElementById('post-' + k);
                if (el) el.textContent = r[k] || 0;
            });
        }
    } catch (e) {}
}

function setupPostReactions() {
    document.querySelectorAll('.reaction-card').forEach(card => {
        card.addEventListener('click', async () => {
            const reaction = card.dataset.reaction;
            if (!reaction) return;
            const last = localStorage.getItem(`lastReaction_${POST_DATA.slug}_${reaction}`);
            if (last && Date.now() - parseInt(last) < 5000) {
                showToast('⏳ تھوڑا انتظار کریں','error');
                return;
            }
            try {
                const res = await fetch(`${WORKER_URL}/api/post-reaction`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ slug: POST_DATA.slug, reaction: reaction, title: POST_DATA.title })
                });
                const result = await res.json();
                if (result.success) {
                    localStorage.setItem(`lastReaction_${POST_DATA.slug}_${reaction}`, Date.now());
                    showToast('❤️ شکریہ!','success');
                    loadPostReactions();
                }
            } catch (e) {
                showToast('⚠️ نیٹ ورک کی خرابی','error');
            }
        });
    });
}

function renderRelatedPosts() {
    const container = document.getElementById('relatedPostsGrid');
    if (!container) return;
    const posts = POST_DATA.relatedPosts || [];
    if (!posts.length) { container.innerHTML = ''; return; }
    container.innerHTML = posts.map(post => `
        <a href="https://bloglovers.pk/${POST_DATA.category}/${post.slug}" class="related-card">
            <img src="${post.image}" alt="${post.title}" loading="lazy" width="200" height="120" onerror="this.src='https://bloglovers.pk/images/default-thumbnail.webp'">
            <div class="title">${post.title}</div>
        </a>
    `).join('');
}

async function renderSidebarTrending() {
    const container = document.getElementById('sidebarTrending');
    if (!container) return;
    try {
        const res = await fetch(`${WORKER_URL}/api/trending`);
        const result = await res.json();
        if (result.success && result.data && result.data.length) {
            container.innerHTML = result.data.slice(0, 4).map(post => `
                <a href="${post.url || `https://bloglovers.pk/${POST_DATA.category}/${post.slug}`}" class="sidebar-post-item">
                    <img src="${post.image || 'https://bloglovers.pk/images/default-thumbnail.webp'}" alt="${post.title}" loading="lazy" width="52" height="52" onerror="this.src='https://bloglovers.pk/images/default-thumbnail.webp'">
                    <span class="title">${post.title}</span>
                </a>
            `).join('');
        } else {
            container.innerHTML = '<div style="color:var(--text-muted);text-align:center;padding:20px 0">کوئی پوسٹ نہیں</div>';
        }
    } catch (e) {
        container.innerHTML = '<div style="color:var(--text-muted);text-align:center;padding:20px 0">لوڈ نہیں ہو سکا</div>';
    }
}

function shareOnSocial(platform) {
    const url = encodeURIComponent(window.location.href);
    const title = encodeURIComponent(document.title);
    const urls = {
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${url}`,
        whatsapp: `https://wa.me/?text=${title}%20${url}`,
        twitter: `https://twitter.com/intent/tweet?text=${title}&url=${url}`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`,
        telegram: `https://t.me/share/url?url=${url}&text=${title}`
    };
    if (urls[platform]) {
        window.open(urls[platform], '_blank', 'width=600,height=500,noopener');
        fetch(`${WORKER_URL}/api/share-site`, { method: 'POST' }).catch(() => {});
    }
}

async function copyPageLink() {
    try {
        await navigator.clipboard.writeText(window.location.href);
        showToast('✅ لنک کاپی ہو گیا!','success');
        fetch(`${WORKER_URL}/api/share-site`, { method: 'POST' }).catch(() => {});
    } catch (e) {
        showToast('⚠️ لنک کاپی نہیں ہو سکا','error');
    }
}

function showToast(msg, type = 'success') {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = 'toast show ' + type;
    clearTimeout(window._toastTimer);
    window._toastTimer = setTimeout(() => { toast.classList.remove('show'); }, 3000);
}

document.addEventListener('DOMContentLoaded', () => {
    calculateReadingTime();
    renderRelatedPosts();
    renderSidebarTrending();
    loadPostViews();
    addPostView();
    loadPostReactions();
    setupPostReactions();
});
</script>

